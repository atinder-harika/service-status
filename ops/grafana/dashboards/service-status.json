{
 "title": "Service Status",
 "uid": "service-status",
 "schemaVersion": 39,
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "refresh": "30s",
 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Services up / down",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "service_status_services{status=\"up\"}",
     "legendFormat": "up"
    },
    {
     "refId": "B",
     "expr": "service_status_services{status=\"down\"}",
     "legendFormat": "down"
    }
   ]
  },
  {
   "id": 2,
   "type": "timeseries",
   "title": "Check cycle time (p95)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(service_status_check_cycle_seconds_bucket[5m])))",
     "legendFormat": "p95 cycle"
    }
   ]
  },
  {
   "id": 3,
   "type": "timeseries",
   "title": "Check time per service (p95)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, service) (rate(service_status_check_seconds_bucket[5m])))",
     "legendFormat": "{{service}}"
    }
   ]
  },
  {
   "id": 4,
   "type": "timeseries",
   "title": "Heap used after GC",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})",
     "legendFormat": "heap used"
    },
    {
     "refId": "B",
     "expr": "sum(jvm_memory_max_bytes{area=\"heap\"})",
     "legendFormat": "heap max"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Live threads",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "jvm_threads_live_threads",
     "legendFormat": "live"
    },
    {
     "refId": "B",
     "expr": "jvm_threads_peak_threads",
     "legendFormat": "peak"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "GC pause time",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(jvm_gc_pause_seconds_sum[5m])",
     "legendFormat": "{{gc}} {{cause}}"
    }
   ]
  }
 ]
}